class Car:
    def __init__(self, colour, model, brand, age, motorpower):
         self.colour = colour
         self.model = model
         self.brand = brand 
         self.age = age 
         self.motorpower = motorpower

    def yr (self):
        x = 2024 - self.age
        print(x)
    
    def tax(self):
        tax = 0
        x = self.age
        power = self.motorpower

        if x <= 10:
            tax = (power*power*30)-20
        elif x > 10 and x < 20:
            tax = (power*power*10) - 20
        elif x >= 20:
            tax = (power*power*5)-40

        print("you will have to pay:",tax,"$/year")



